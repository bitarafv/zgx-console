[Unit]
Description=Always-on public ZGX Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/zgx-console
Environment=PATH=%h/miniforge3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/zgx-console/scripts/public-supervisor
Restart=on-failure
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=15s
SendSIGKILL=yes
SuccessExitStatus=143 SIGTERM
RestartSec=3

[Install]
WantedBy=default.target
