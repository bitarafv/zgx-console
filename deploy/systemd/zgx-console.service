[Unit]
Description=Always-on public ZGX Console
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=%h/projects/siva-apps/dietplan/zgx-console
Environment=PATH=%h/miniforge3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/siva-apps/dietplan/zgx-console/scripts/public-supervisor
Restart=on-failure
RestartSec=3
[Install]
WantedBy=default.target
