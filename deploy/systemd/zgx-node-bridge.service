[Unit]
Description=ZGX Console live Nano bridge
After=network-online.target zgx-console.service
Wants=network-online.target
Requires=zgx-console.service

[Service]
Type=simple
WorkingDirectory=%h/projects/zgx-console
Environment=PATH=%h/miniforge3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/zgx-console/scripts/bridge-supervisor
Restart=on-failure
KillMode=control-group
TimeoutStopSec=10s
RestartSec=3

[Install]
WantedBy=default.target
