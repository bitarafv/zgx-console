ZGX_RUNTIME_MODE=mock
ZGX_PUBLIC_HOSTNAME=zgxconsole.bncvc.com
ZGX_LOCAL_ADMIN=false
ZGX_NODE_ORIGIN=http://127.0.0.1:18000
ZGX_NODE_BRIDGE_ORIGIN=http://127.0.0.1:60372
NEXT_PUBLIC_ZGX_SIMULATION_URL=/simulation
DEFAULT_ELECTRICITY_RATE=0.15
DEFAULT_SOC_POWER_WATTS=35.0
ZGX_SIMULATION_ORIGIN=http://127.0.0.1:60371
ZGX_ADMIN_EMAILS=bitarafv@gmail.com
ZGX_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ZGX_ACCESS_AUDS=
ZGX_MOCK_ADMIN=false
# Created locally by ./zgx setup; never commit values.
ZGX_BRIDGE_TOKEN=
ZGX_ADMIN_BRIDGE_SECRET=
# Optional path to a Nano-local Cloudflare named-tunnel token file.
CLOUDFLARE_TUNNEL_TOKEN=
# Demo booking persistence, signed email actions, and Namecheap Private Email SMTP.
ZGX_BOOKING_DATA_PATH=./data/demo-bookings.json
ZGX_BOOKING_SIGNING_SECRET=
ZGX_ADMIN_NOTIFICATION_EMAIL=
ZGX_SMTP_HOST=mail.privateemail.com
ZGX_SMTP_PORT=465
ZGX_SMTP_USER=
ZGX_SMTP_PASSWORD=
# Exact normalized email exempt from the one-request-per-24-hours limit.
ZGX_BOOKING_LIMIT_EXEMPT_EMAIL=bitarafv@yahoo.com
# Public HTTPS origin used in visitor access links.
ZGX_PUBLIC_ORIGIN=https://zgxconsole.bncvc.com
# Visitor replies are polled over TLS IMAP. User/password fall back to SMTP values.
ZGX_BOOKING_REPLY_TO=
ZGX_IMAP_HOST=mail.privateemail.com
ZGX_IMAP_PORT=993
ZGX_IMAP_USER=
ZGX_IMAP_PASSWORD=
