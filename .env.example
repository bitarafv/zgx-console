# mock: fixture data and simulated controls; node/cloud: proxy the Siva API.
ZGX_RUNTIME_MODE=mock
ZGX_NODE_ORIGIN=http://127.0.0.1:18000

# Comma-separated identities accepted from Cloudflare Access in cloud mode.
ZGX_ADMIN_EMAILS=owner@example.com

# Enables admin controls only for local mock development.
ZGX_MOCK_ADMIN=false

