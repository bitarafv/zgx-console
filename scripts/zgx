#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd); RUN="$ROOT/.run"; LOG="$ROOT/.logs"; ENV_FILE="$ROOT/.env.local"
mkdir -p "$RUN" "$LOG"; if [[ -f "$ENV_FILE" ]];then set -a;source "$ENV_FILE";set +a;fi
ZGX_BRIDGE_TOKEN=${ZGX_BRIDGE_TOKEN:-}; ZGX_ADMIN_BRIDGE_SECRET=${ZGX_ADMIN_BRIDGE_SECRET:-}
WEB_PORT=${ZGX_WEB_PORT:-60370}; SIM_PORT=${ZGX_SIMULATION_PORT:-60371}; BRIDGE_PORT=${ZGX_BRIDGE_PORT:-60372}
port_busy(){ ss -ltnH "sport = :$1" 2>/dev/null|grep -q .; }
owned(){ local f="$RUN/$1.pid";[[ -f "$f" ]]||return 1;local p;p=$(<"$f");kill -0 "$p" 2>/dev/null||return 1;local cwd;cwd=$(readlink "/proc/$p/cwd" 2>/dev/null||true);[[ "$cwd" == "$ROOT"* ]]; }
launch(){ local name=$1 dir=$2;shift 2;if owned "$name";then echo "$name already running";return;fi;local port="";if [[ ${1:-} == port:* ]];then port=${1#*:};shift;if port_busy "$port";then echo "Refusing: port $port is owned by another process" >&2;exit 1;fi;fi;(cd "$dir";nohup setsid "$@" >"$LOG/$name.log" 2>&1&echo $!>"$RUN/$name.pid"); }
stop_one(){ local name=$1;if ! owned "$name";then rm -f "$RUN/$name.pid";echo "$name not running";return;fi;local p;p=$(<"$RUN/$name.pid");kill -- "-$p";for _ in {1..20};do kill -0 "$p" 2>/dev/null||break;sleep .25;done;if kill -0 "$p" 2>/dev/null;then echo "Refusing to force-kill $name; inspect PID $p" >&2;return 1;fi;rm -f "$RUN/$name.pid";echo "$name stopped"; }
need_secrets(){ [[ ${#ZGX_BRIDGE_TOKEN} -ge 24 && ${#ZGX_ADMIN_BRIDGE_SECRET} -ge 24 ]]||{ echo "Run ./zgx setup to create local bridge secrets" >&2;exit 1;}; }
need_builds(){ [[ -d "$ROOT/apps/web/.next"&&-d "$ROOT/apps/simulation/.next" ]]||{ echo "Production builds missing; run ./zgx setup" >&2;exit 1;}; }
wait_siva(){ for _ in {1..20};do curl -fsS --max-time 2 http://127.0.0.1:18000/api/workloads >/dev/null 2>&1&&return;sleep .5;done;echo "Siva is unavailable on 127.0.0.1:18000; it was not modified" >&2;exit 1; }
setup(){ command -v node>/dev/null;command -v npm>/dev/null;[[ -f "$ENV_FILE" ]]||cp "$ROOT/.env.example" "$ENV_FILE";if ! grep -q '^ZGX_BRIDGE_TOKEN=.' "$ENV_FILE";then printf '\nZGX_BRIDGE_TOKEN=%s\nZGX_ADMIN_BRIDGE_SECRET=%s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" >>"$ENV_FILE";fi;npm --prefix "$ROOT/apps/web" ci;npm --prefix "$ROOT/apps/simulation" ci;npm --prefix "$ROOT/apps/web" run build;NEXT_PUBLIC_BASE_PATH=/simulation npm --prefix "$ROOT/apps/simulation" run build;npm --prefix "$ROOT/apps/node-bridge" test;echo "Setup complete."; }
public_start(){ need_builds;if systemctl --user cat zgx-console.service >/dev/null 2>&1;then systemctl --user start zgx-console.service;return;fi;launch simulation "$ROOT" "port:$SIM_PORT" env NEXT_PUBLIC_BASE_PATH=/simulation npm --prefix apps/simulation start -- --hostname 127.0.0.1 --port "$SIM_PORT";launch web "$ROOT" "port:$WEB_PORT" env ZGX_RUNTIME_MODE=cloud ZGX_LOCAL_ADMIN=true ZGX_NODE_BRIDGE_ORIGIN="http://127.0.0.1:$BRIDGE_PORT" ZGX_BRIDGE_TOKEN="$ZGX_BRIDGE_TOKEN" ZGX_ADMIN_BRIDGE_SECRET="$ZGX_ADMIN_BRIDGE_SECRET" ZGX_ADMIN_EMAILS="${ZGX_ADMIN_EMAILS:-bitarafv@gmail.com}" ZGX_SIMULATION_ORIGIN="http://127.0.0.1:$SIM_PORT" NEXT_PUBLIC_ZGX_SIMULATION_URL=/simulation npm --prefix apps/web start -- --hostname 127.0.0.1 --port "$WEB_PORT"; }
start(){ need_secrets;public_start;wait_siva;launch bridge "$ROOT" "port:$BRIDGE_PORT" env ZGX_BRIDGE_HOST=127.0.0.1 ZGX_BRIDGE_PORT="$BRIDGE_PORT" ZGX_NODE_ORIGIN=http://127.0.0.1:18000 ZGX_BRIDGE_TOKEN="$ZGX_BRIDGE_TOKEN" ZGX_ADMIN_BRIDGE_SECRET="$ZGX_ADMIN_BRIDGE_SECRET" npm --prefix apps/node-bridge start;sleep 2;"$0" status; }
stop(){ stop_one bridge||true;echo "Public ZGX Console remains online in static-node mode. Siva and workloads were left untouched."; }
public_stop(){ if systemctl --user cat zgx-console.service >/dev/null 2>&1;then systemctl --user stop zgx-console.service;else stop_one web||true;stop_one simulation||true;fi; }
status(){ for entry in "web:$WEB_PORT" "simulation:$SIM_PORT" "bridge:$BRIDGE_PORT";do name=${entry%%:*};port=${entry##*:};if owned "$name";then echo "$name: running (PID $(<"$RUN/$name.pid"))";elif port_busy "$port";then echo "$name: running (managed service)";else echo "$name: stopped";fi;done;if systemctl is-active --quiet cloudflared.service 2>/dev/null;then echo "tunnel: active (system service)";else echo "tunnel: inactive";fi;if curl -fsS --max-time 2 http://127.0.0.1:18000/api/workloads >/dev/null 2>&1;then echo "siva: reachable (unmanaged)";else echo "siva: unavailable";fi; }
dev(){ need_secrets;trap 'kill 0' EXIT INT TERM;(cd "$ROOT/apps/node-bridge";ZGX_BRIDGE_PORT="$BRIDGE_PORT" ZGX_BRIDGE_TOKEN="$ZGX_BRIDGE_TOKEN" ZGX_ADMIN_BRIDGE_SECRET="$ZGX_ADMIN_BRIDGE_SECRET" npm start)&(cd "$ROOT/apps/simulation";NEXT_PUBLIC_BASE_PATH=/simulation npm run dev -- --hostname 127.0.0.1 --port "$SIM_PORT")&(cd "$ROOT/apps/web";ZGX_RUNTIME_MODE=node ZGX_NODE_BRIDGE_ORIGIN="http://127.0.0.1:$BRIDGE_PORT" ZGX_BRIDGE_TOKEN="$ZGX_BRIDGE_TOKEN" ZGX_ADMIN_BRIDGE_SECRET="$ZGX_ADMIN_BRIDGE_SECRET" npm run dev -- --hostname 127.0.0.1 --port "$WEB_PORT")&wait; }
case ${1:-status} in setup)setup;;public-start)need_secrets;public_start;;public-stop)public_stop;;start)start;;stop)stop;;restart)stop;start;;shutdown)stop;public_stop;;status)status;;logs)tail -n 100 -F "$LOG"/*.log;;dev)dev;;*)echo "Usage: ./zgx {setup|public-start|start|stop|restart|status|logs|dev|shutdown}" >&2;exit 2;;esac
