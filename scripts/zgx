#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
RUN="$ROOT/.run"; LOG="$ROOT/.logs"; ENV_FILE="$ROOT/.env.local"
mkdir -p "$RUN" "$LOG"
if [[ -f "$ENV_FILE" ]]; then set -a; source "$ENV_FILE"; set +a; fi
ZGX_BRIDGE_TOKEN=${ZGX_BRIDGE_TOKEN:-}
ZGX_ADMIN_BRIDGE_SECRET=${ZGX_ADMIN_BRIDGE_SECRET:-}
WEB_PORT=${ZGX_WEB_PORT:-60370}; SIM_PORT=${ZGX_SIMULATION_PORT:-60371}; BRIDGE_PORT=${ZGX_BRIDGE_PORT:-60372}
port_busy(){ ss -ltnH "sport = :$1" 2>/dev/null | grep -q .; }
owned(){ local f="$RUN/$1.pid"; [[ -f "$f" ]]||return 1; local p; p=$(<"$f"); kill -0 "$p" 2>/dev/null||return 1; local cwd; cwd=$(readlink "/proc/$p/cwd" 2>/dev/null||true); [[ "$cwd" == "$ROOT"* ]]; }
launch(){ local name=$1 dir=$2; shift 2; if owned "$name";then echo "$name already running";return;fi; local port=${1#*:}; if [[ "$1" == port:* ]];then shift;if port_busy "$port";then echo "Refusing: port $port is owned by another process" >&2;exit 1;fi;fi; (cd "$dir"; nohup setsid "$@" >"$LOG/$name.log" 2>&1 & echo $! >"$RUN/$name.pid"); }
stop_one(){ local name=$1;if ! owned "$name";then rm -f "$RUN/$name.pid";echo "$name not running";return;fi;local p;p=$(<"$RUN/$name.pid");kill -- "-$p";for _ in {1..20};do kill -0 "$p" 2>/dev/null||break;sleep .25;done;if kill -0 "$p" 2>/dev/null;then echo "Refusing to force-kill $name; inspect PID $p" >&2;return 1;fi;rm -f "$RUN/$name.pid";echo "$name stopped"; }
need_secrets(){ [[ ${#ZGX_BRIDGE_TOKEN} -ge 24 && ${#ZGX_ADMIN_BRIDGE_SECRET} -ge 24 ]]||{ echo "Run ./zgx setup to create local bridge secrets" >&2;exit 1;}; }
setup(){ command -v node >/dev/null; command -v npm >/dev/null; [[ -f "$ENV_FILE" ]]||cp "$ROOT/.env.example" "$ENV_FILE"; if ! grep -q '^ZGX_BRIDGE_TOKEN=.' "$ENV_FILE";then printf '\nZGX_BRIDGE_TOKEN=%s\nZGX_ADMIN_BRIDGE_SECRET=%s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" >>"$ENV_FILE";fi; npm --prefix "$ROOT/apps/web" ci; npm --prefix "$ROOT/apps/simulation" ci; npm --prefix "$ROOT/apps/web" run build; NEXT_PUBLIC_BASE_PATH=/simulation npm --prefix "$ROOT/apps/simulation" run build; npm --prefix "$ROOT/apps/node-bridge" test; echo "Setup complete. Secrets are stored only in .env.local."; }
start(){ need_secrets; [[ -d "$ROOT/apps/web/.next" && -d "$ROOT/apps/simulation/.next" ]]||{ echo "Production builds missing; run ./zgx setup" >&2;exit 1;}; for _ in {1..20}; do curl -fsS --max-time 2 http://127.0.0.1:18000/api/workloads >/dev/null 2>&1 && break; sleep .5; done; curl -fsS --max-time 2 http://127.0.0.1:18000/api/workloads >/dev/null||{ echo "Siva is unavailable on 127.0.0.1:18000; it was not modified" >&2;exit 1;}; launch bridge "$ROOT" "port:$BRIDGE_PORT" env ZGX_BRIDGE_HOST=127.0.0.1 ZGX_BRIDGE_PORT="$BRIDGE_PORT" ZGX_NODE_ORIGIN=http://127.0.0.1:18000 ZGX_BRIDGE_TOKEN="$ZGX_BRIDGE_TOKEN" ZGX_ADMIN_BRIDGE_SECRET="$ZGX_ADMIN_BRIDGE_SECRET" npm --prefix apps/node-bridge start; launch simulation "$ROOT" "port:$SIM_PORT" env NEXT_PUBLIC_BASE_PATH=/simulation npm --prefix apps/simulation start -- --hostname 127.0.0.1 --port "$SIM_PORT"; launch web "$ROOT" "port:$WEB_PORT" env ZGX_RUNTIME_MODE=node ZGX_NODE_BRIDGE_ORIGIN="http://127.0.0.1:$BRIDGE_PORT" ZGX_BRIDGE_TOKEN="$ZGX_BRIDGE_TOKEN" ZGX_ADMIN_BRIDGE_SECRET="$ZGX_ADMIN_BRIDGE_SECRET" ZGX_SIMULATION_ORIGIN="http://127.0.0.1:$SIM_PORT" NEXT_PUBLIC_ZGX_SIMULATION_URL=/simulation npm --prefix apps/web start -- --hostname 127.0.0.1 --port "$WEB_PORT"; if [[ -n ${ZGX_TUNNEL_TOKEN_FILE:-} && -x $(command -v cloudflared||true) ]];then launch tunnel "$ROOT" env cloudflared --no-autoupdate tunnel run --token-file "$ZGX_TUNNEL_TOKEN_FILE";else echo "Cloudflare Tunnel not started (configure ZGX_TUNNEL_TOKEN_FILE when ready).";fi;sleep 2;"$0" status; }
status(){ for name in web simulation bridge tunnel;do if owned "$name";then echo "$name: running (PID $(<"$RUN/$name.pid"))";else echo "$name: stopped";fi;done;if curl -fsS --max-time 2 http://127.0.0.1:18000/api/workloads >/dev/null 2>&1;then echo "siva: reachable (unmanaged by this command)";else echo "siva: unavailable";fi; }
stop(){ stop_one tunnel||true;stop_one web||true;stop_one simulation||true;stop_one bridge||true;echo "Siva and its workloads were left untouched."; }
dev(){ need_secrets;trap 'kill 0' EXIT INT TERM; (cd "$ROOT/apps/node-bridge";ZGX_BRIDGE_PORT="$BRIDGE_PORT" ZGX_BRIDGE_TOKEN="$ZGX_BRIDGE_TOKEN" ZGX_ADMIN_BRIDGE_SECRET="$ZGX_ADMIN_BRIDGE_SECRET" npm start)& (cd "$ROOT/apps/simulation";NEXT_PUBLIC_BASE_PATH=/simulation npm run dev -- --hostname 127.0.0.1 --port "$SIM_PORT")& (cd "$ROOT/apps/web";ZGX_RUNTIME_MODE=node ZGX_NODE_BRIDGE_ORIGIN="http://127.0.0.1:$BRIDGE_PORT" ZGX_BRIDGE_TOKEN="$ZGX_BRIDGE_TOKEN" ZGX_ADMIN_BRIDGE_SECRET="$ZGX_ADMIN_BRIDGE_SECRET" npm run dev -- --hostname 127.0.0.1 --port "$WEB_PORT")& wait; }
case ${1:-status} in setup)setup;;start)start;;stop)stop;;restart)stop;start;;status)status;;logs)tail -n 100 -F "$LOG"/*.log;;dev)dev;;*)echo "Usage: ./zgx {setup|start|stop|restart|status|logs|dev}" >&2;exit 2;;esac
